<view class="page"><view class="title">确认创作方案</view><block wx:if="{{preview}}">
<view class="panel"><view class="heading">{{label}}</view><view class="note">{{preview.plan.original}}</view><view class="line plan-row"><text>目标</text><text>{{preview.plan.goal}}</text></view><view class="line plan-row"><text>受众</text><text>{{preview.plan.audience}}</text></view><view class="line plan-row"><text>切入点</text><text>{{preview.plan.angle}}</text></view><block wx:if="{{preview.kind!=='copy'}}"><view class="line plan-row"><text>画面</text><text>{{preview.plan.design.name}}</text></view><view wx:if="{{preview.plan.posterArt.concept}}" class="note">{{preview.plan.posterArt.concept}}</view><view class="line plan-row"><text>输出</text><text>{{preview.plan.output.width}} × {{preview.plan.output.height}} px · {{preview.kind==='poster'?preview.plan.output.dpi+' DPI':'9 秒'}}</text></view></block><view class="line plan-row"><text>本次用量</text><text>{{preview.cost}} 积分</text></view></view>
<button wx:if="{{preview.fullPosterPrompt && (!preview.requiresCopyChoice || copyChoice)}}" class="link" bindtap="copyPosterPrompt">复制直出提示词草案</button>
<view wx:if="{{preview.requiresCopyChoice}}" class="panel"><view class="heading">选择海报文案</view>
<radio-group bindchange="chooseCopy"><label wx:for="{{options}}" wx:key="token" class="line copy-option"><radio value="{{item.token}}" checked="{{copyChoice===item.token}}" disabled="{{busy}}"/><view><view>{{item.title}}</view><view class="sub">{{item.body}}</view><view>{{item.cta}}</view></view></label></radio-group>
<button class="secondary" bindtap="loadOptions" loading="{{busy}}" disabled="{{busy}}">{{options.length?'换一组文案':'生成候选文案'}}</button></view>
<button class="primary" loading="{{busy}}" disabled="{{busy || (preview.requiresCopyChoice && !copyChoice)}}" bindtap="submit">确认生成{{label}}</button></block>
<view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!preview}}" class="secondary" bindtap="home">返回创作</button></view>
