<view class="page"><view class="title">确认创作方案</view><block wx:if="{{preview}}">
<view class="panel"><view class="heading">{{label}}</view><view class="note">{{preview.plan.original}}</view><view class="line">目标　{{preview.plan.goal}}</view><view class="line">受众　{{preview.plan.audience}}</view><view class="line">切入点　{{preview.plan.angle}}</view><block wx:if="{{preview.kind!=='copy'}}"><view class="line">画面　{{preview.plan.design.name}}</view><view wx:if="{{preview.plan.posterArt.concept}}" class="note">{{preview.plan.posterArt.concept}}</view><view class="line">输出　{{preview.plan.output.width}} × {{preview.plan.output.height}} px · {{preview.kind==='poster'?preview.plan.output.dpi+' DPI':'9 秒'}}</view></block><view class="line">本次用量　{{preview.cost}} 积分</view></view>
<button wx:if="{{preview.fullPosterPrompt &amp;&amp; (!preview.requiresCopyChoice || copyChoice)}}" class="link" bindtap="copyPosterPrompt">复制直出提示词草案</button>
<view wx:if="{{preview.requiresCopyChoice}}" class="panel"><view class="heading">选择海报文案</view>
<radio-group bindchange="chooseCopy"><label wx:for="{{options}}" wx:key="token" class="line"><radio value="{{item.token}}" checked="{{copyChoice===item.token}}" disabled="{{busy}}"/>{{item.title}}<view>{{item.body}}</view><view>{{item.cta}}</view></label></radio-group>
<button class="secondary" bindtap="loadOptions" loading="{{busy}}" disabled="{{busy}}">{{options.length?'换一组文案':'生成候选文案'}}</button></view>
<button class="primary" loading="{{busy}}" disabled="{{busy || (preview.requiresCopyChoice &amp;&amp; !copyChoice)}}" bindtap="submit">确认生成{{label}}</button></block>
<view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!preview}}" class="secondary" bindtap="home">返回创作</button></view>
