page {
  background: white;
}
.title {
  font-size: 62rpx;
}
.new {
  min-height: 44px;
  color: #224e33;
  background: #e5f2db;
  border-radius: 30rpx;
  padding: 16rpx 22rpx;
}
.filter {
  white-space: nowrap;
  margin: 26rpx 0;
}
.filter button {
  display: inline-block;
  border-radius: 9rpx;
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  align-items: start;
  padding-bottom: 48rpx;
}
.card {
  width: 100%;
  min-width: 0;
  text-align: left;
}
.card image {
  display: block;
  width: 100%;
  border-radius: 12rpx;
  height: calc(64vw - 46rpx);
}
.name {
  font-weight: 650;
  font-size: 31rpx;
  margin-top: 8rpx;
}
.example {
  width: 100%;
  height: 39vh;
  margin-top: 10rpx;
}
