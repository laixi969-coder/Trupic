<view class="page"><view class="between"><view class="title">灵感选集</view><button class="new" bindtap="create">自主创作</button></view>
<scroll-view class="filter" scroll-x><button wx:for="{{categories}}" wx:key="*this" class="chip {{category===item?'active':''}}" data-cat="{{item}}" bindtap="filter">{{item}}</button></scroll-view>
<view class="grid"><button wx:for="{{samples}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><image src="{{item.img}}" mode="aspectFill"/><view class="name">{{item.name}}</view><text class="sub">{{item.category}}海报</text></button></view></view>
<block wx:if="{{selected}}"><view class="sheetmask" bindtap="close"></view><view class="sheet"><view class="between"><view class="heading">{{selected.name}}</view><button class="close" bindtap="close">关闭</button></view><image class="example" src="{{selected.img}}" mode="aspectFit"/><view class="note">{{selected.brief}}</view><button class="primary" bindtap="use">用这个方向创作</button></view></block>
