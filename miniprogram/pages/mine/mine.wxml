<view class="page"><view class="title">我的作品</view><view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view>
<block wx:if="{{loaded}}"><view class="panel"><view class="between"><view class="heading">{{profile.name || '商家档案'}}</view><button class="link" bindtap="edit">编辑档案</button></view><view class="sub">可用积分　{{credits}}</view></view>
<button wx:for="{{jobs}}" wx:key="id" class="work" bindtap="open" data-key="job" data-id="{{item.id}}">{{item.state==='failed'?'制作未完成 · 查看并重试':'制作中 · 查看进度'}}</button>
<button wx:for="{{works}}" wx:key="id" class="work" bindtap="open" data-key="id" data-id="{{item.id}}"><view class="sub">{{item.label}}</view><view class="name">{{item.title}}</view></button>
<block wx:if="{{!works.length && !jobs.length}}"><view class="note">第一份作品，从一句推广需求开始。</view><button class="primary" bindtap="create">去创作</button></block></block></view>
<block wx:if="{{edit}}"><view class="sheetmask" bindtap="close"></view><view class="sheet"><view class="between"><view class="heading">商家档案</view><button class="close" bindtap="close">关闭</button></view><view class="label">商家名称</view><input class="field" data-key="name" value="{{form.name}}" bindinput="field"/><view class="label">主营商品</view><input class="field" data-key="product" value="{{form.product}}" bindinput="field"/><view class="label">已确认的商品卖点</view><textarea class="field" maxlength="400" data-key="facts" value="{{form.facts}}" bindinput="field"/><button class="primary spaced" bindtap="save" disabled="{{saving}}">保存档案</button></view></block>
