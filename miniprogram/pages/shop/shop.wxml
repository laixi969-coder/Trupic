<view class="page"><view class="title">套餐与积分</view>
<view wx:if="{{error}}" class="error">{{error}}<button class="link" bindtap="load">重新加载</button></view>
<view class="panel"><view class="between"><view class="heading">可用积分　{{credits}}</view><button class="link" bindtap="account">{{account?'账号 '+account:'绑定账号'}}</button></view>
  <view wx:if="{{subscription}}" class="note">当前套餐 · {{subscription}}</view>
  <view wx:if="{{!account}}" class="note">购买前请先绑定商家账号，积分和订单会保存在账号里。</view></view>
<view wx:for="{{offers}}" wx:key="id" class="panel">
  <view class="between"><view><view class="heading">{{item.name}}</view><view class="sub">{{item.cycleName}} · {{item.credits}} 积分{{item.cycle==='pack'?'':'/月'}}{{item.bonus?' · 赠 '+item.bonus+' 积分':''}}</view></view><view class="heading">¥{{item.money}}</view></view>
  <button class="primary spaced" data-id="{{item.id}}" bindtap="buy" disabled="{{!!busy || !canPay || !account}}" loading="{{busy===item.id}}">{{!canPay?'暂未开放购买':!account?'先绑定账号':'购买'}}</button>
</view>
<block wx:if="{{orders.length}}"><view class="heading section">订单</view>
  <view wx:for="{{orders}}" wx:key="id" class="panel"><view class="between"><view><view>{{item.name}}</view><view class="sub">¥{{item.money}} · {{item.stateName}}</view></view><button wx:if="{{item.checkout}}" class="link" data-id="{{item.id}}" bindtap="copyOrder">复制付款链接</button></view></view>
</block>
<button class="link spaced" bindtap="load">我已付款，刷新</button>
</view>
