<view wx:if="{{!studio}}" class="page moment-page">
  <view class="title">今天的朋友圈</view>
  <view class="panel">
    <button class="moment-photo" aria-label="{{momentAsset?'更换照片':'拍照或从相册选图'}}" bindtap="takeMomentPhoto" disabled="{{busy || momentCost===null}}">
      <image wx:if="{{momentPhoto}}" src="{{momentPhoto}}" mode="aspectFit"/>
      <text wx:if="{{!momentPhoto}}" class="camera-icon" aria-hidden="true"></text>
      <text class="{{momentPhoto?'change-photo':''}}">{{momentAsset?'换张照片':'拍照或从相册选图'}}</text>
    </button>
    <view class="label">补一句话 <text class="sub">（选填）</text></view>
    <textarea class="moment-note" aria-label="补一句话，选填" maxlength="140" value="{{momentNote}}" bindinput="momentInput" disabled="{{busy || momentCost===null}}" placeholder="比如：今天多烤了 10 个可颂，下午 4 点能取。"/>
    <view class="row moment-format"><text class="sub">画幅</text>
      <button class="chip {{momentRatio==='portrait'?'active':''}}" aria-pressed="{{momentRatio==='portrait'}}" data-ratio="portrait" bindtap="momentFormat" disabled="{{busy || momentCost===null}}">3:4</button>
      <button class="chip {{momentRatio==='story'?'active':''}}" aria-pressed="{{momentRatio==='story'}}" data-ratio="story" bindtap="momentFormat" disabled="{{busy || momentCost===null}}">9:16</button>
    </view>
    <view wx:if="{{momentError}}" class="error" aria-live="polite">{{momentError}}</view>
    <button wx:if="{{momentCost===null && momentError}}" class="secondary" bindtap="loadMoment">重新连接</button>
    <button wx:else class="primary" disabled="{{busy || !momentAsset || momentCost===null}}" loading="{{busy}}" bindtap="makeMoment">{{momentJob?'查看这条朋友圈':'做好今天这条朋友圈'}}{{momentCost!==null && !momentJob?' · '+momentCost+' 积分':''}}</button>
  </view>
  <button class="link" bindtap="toggleStudio" disabled="{{busy}}">其他创作 ›</button>
</view>
<view wx:else class="page">
  <button class="link" bindtap="toggleStudio" disabled="{{busy}}">‹ 今天的朋友圈</button>
  <view class="title">今天要推广什么？</view>
  <view class="panel">
    <view class="row"><button wx:for="{{kinds}}" wx:key="id" data-kind="{{item.id}}" bindtap="changeKind" aria-pressed="{{item.id===kind}}" class="chip {{item.id===kind?'active':''}}">{{item.name}}</button></view>
    <textarea class="prompt" aria-label="创作需求" focus="{{focusBrief}}" bindblur="blurBrief" value="{{brief}}" bindinput="input" maxlength="1200" placeholder="比如，给新品抹茶拿铁做张海报，邀请附近的上班族午休来店。" adjust-position="{{true}}"/>
    <view wx:if="{{briefError}}" class="error" aria-live="polite">{{briefError}}</view>
    <view class="between tools">
      <button wx:if="{{asset}}" class="link" bindtap="showPhoto">{{assetConfirmed?'已选素材':'核对素材'}}</button>
      <button wx:else class="link" bindtap="addPhoto" disabled="{{busy}}" loading="{{uploading}}">{{uploading?'上传中':'＋ 商品素材'}}</button>
      <button wx:if="{{kind!=='copy'}}" class="format" bindtap="settings">{{format.ratio}} · {{format.resolution}} px · {{kind==='video'?'9 秒':format.dpi+' DPI'}}</button>
    </view>
    <button class="primary" bindtap="preview" loading="{{busy && !uploading}}" disabled="{{busy}}">预览创作方案</button>
  </view>
  <view wx:if="{{topics.length || topicsError}}" class="section">
    <view class="heading">本周营销主题</view>
    <button wx:for="{{topics}}" wx:key="topicId" class="topic line between" data-id="{{item.topicId}}" bindtap="useTopic"><text>{{item.title}}</text><text class="sub">{{item.adopted?'已制作':'用这个主题'}} ›</text></button>
    <button wx:if="{{topicsError}}" class="link" bindtap="loadTopics">重新加载本周主题</button>
  </view>
  <view class="between"><view class="heading">找个灵感开始</view><button class="link" bindtap="gallery">查看全部</button></view>
  <button class="hero" bindtap="sample" data-id="tea"><image src="/images/tea-hero.jpg" mode="aspectFill"/><view class="heroTitle">抹茶拿铁<view>上新海报</view></view><view class="heroLink">查看茶饮样张</view></button>
  <button class="mini row" bindtap="sample" data-id="auto"><image src="/images/auto.jpg" mode="aspectFill"/><view><view>周末试驾</view><view class="sub">汽车海报</view></view></button>
</view>
<block wx:if="{{sheet}}">
  <view class="sheetmask" bindtap="close"></view>
  <view class="sheet">
    <view class="between"><view class="heading">{{sheet==='asset'?'核对商品图':'输出规格'}}</view><button class="close" bindtap="close">关闭</button></view>
    <block wx:if="{{sheet==='format'}}">
      <picker range="{{ratios}}" value="{{ratioIndex}}" data-key="ratio" bindchange="selectFormat"><view class="line between"><text>画幅</text><text>{{format.ratio}}　›</text></view></picker>
      <picker range="{{resolutions}}" value="{{resolutionIndex}}" data-key="resolution" bindchange="selectFormat"><view class="line between"><text>短边分辨率</text><text>{{format.resolution}} px　›</text></view></picker>
      <picker wx:if="{{kind==='poster'}}" range="{{dpis}}" value="{{dpiIndex}}" data-key="dpi" bindchange="selectFormat"><view class="line between"><text>印刷精度</text><text>{{format.dpi}} DPI　›</text></view></picker>
      <button class="primary spaced" bindtap="close">完成</button>
    </block>
    <block wx:else>
      <image wx:if="{{assetImage}}" class="photo" src="{{assetImage}}" mode="aspectFit"/>
      <view wx:elif="{{photoError}}" class="photo-status"><text>{{photoError}}</text><button class="link" bindtap="showPhoto">重新加载商品图</button></view>
      <view wx:else class="photo-status">正在加载商品图…</view>
      <view class="line between">使用上传原图<switch checked="{{assetMode==='original'}}" bindchange="togglePhoto" color="#184b32"/></view>
      <button wx:if="{{!asset.risk}}" class="link" bindtap="startMark">{{identityRegion?'重新标注原图区域':'标注需保真的标识或包装文字'}}</button>
      <button wx:if="{{kind==='video' && !asset.risk}}" class="link" bindtap="startMark" data-target="detail">{{visualDetail?'重新框选中镜细节':'指定短片中镜的细节（选填）'}}</button>
      <block wx:if="{{marking}}">
        <view class="note">{{firstCorner?'再点选区对角':markingDetail?'在原图上框住第 3–6 秒要展示的细节。':'在原图上点选标识的一角，再点对角。'}}</view>
        <view class="region-wrap"><image class="region-image" src="{{regionImage}}" mode="widthFix" bindtap="markPoint"/><view wx:if="{{regionStyle}}" class="region-outline" style="{{regionStyle}}"/></view>
      </block>
      <button wx:if="{{identityRegion}}" class="link" bindtap="clearRegion">清除标识选区</button>
      <block wx:if="{{kind==='video' && visualDetail}}">
        <input class="line" maxlength="20" placeholder="框内可见的卖点，如杯壁刻度" value="{{visualDetail.label}}" bindinput="detailLabel"/>
        <button class="link" bindtap="clearRegion" data-target="detail">清除中镜细节</button>
      </block>
      <view wx:if="{{asset.risk}}" class="error">图片质量不足，建议移除后更换清晰原图。</view>
      <button class="primary spaced" disabled="{{!assetImage || firstCorner || asset.risk}}" bindtap="acceptPhoto">确认素材</button>
      <button class="secondary spaced" bindtap="removePhoto">移除素材</button>
    </block>
  </view>
</block>
