<view wx:if="{{!homeVerified}}" class="page home-connection">
  <view class="heading">响指出片</view>
  <view class="note" aria-live="polite">{{momentError || '正在连接工作区…'}}</view>
  <button wx:if="{{momentError}}" class="secondary" bindtap="onShow">重新连接</button>
</view>
<view wx:elif="{{personalAgent && !studio && !legacyMoment}}" class="assistant-home">
  <view class="assistant-bar">
    <view class="assistant-brand"><image src="/images/assistant-mark.png" aria-hidden="true"/>营销助理</view>
    <button class="assistant-history" bindtap="homeHistory" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}"><image src="/images/assistant-history.png" aria-hidden="true"/>历史对话</button>
  </view>
  <view class="assistant-content">
    <view class="assistant-intro">
      <view class="assistant-lead">
        <view class="assistant-heading">{{homePhoto?'这张图，':'今天想'}}</view>
        <view class="assistant-heading">{{homePhoto?'想怎么发？':'推广什么？'}}</view>
        <view class="assistant-hint" aria-live="polite">{{homeVoiceState==='listening'?'正在听，点一下结束。':homeVoiceState==='transcribing'?'正在把语音转成文字…':homeVoiceState==='authorizing'?'请允许使用麦克风。':'点麦克风，说完可以改字。'}}</view>
      </view>
      <button class="mic-control {{homeVoiceState==='listening'?'is-listening':''}}" bindtap="toggleHomeVoice" aria-label="{{homeVoiceState==='listening'?'结束本次听写':homeVoiceLabel}}" disabled="{{homeNavigating || homeVoiceState==='authorizing' || homeVoiceState==='transcribing'}}">
        <view class="mic-disc"><view wx:if="{{homeVoiceState==='listening'}}" class="mic-stop"></view><image wx:else src="/images/assistant-mic.png" aria-hidden="true"/><text>{{homeVoiceLabel}}</text></view>
      </button>
    </view>
    <view wx:if="{{homePhoto}}" class="assistant-photo">
      <button class="photo-preview" bindtap="previewHomePhoto" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}" aria-label="查看完整商品图"><image class="assistant-image" src="{{homePhoto}}" mode="aspectFit"/></button>
      <view class="photo-tools"><button bindtap="pickHomePhoto" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}">换图</button><button bindtap="removeHomePhoto" disabled="{{homeNavigating}}">移除</button></view>
    </view>
    <view wx:if="{{homePhoto && (homeUploading || homePhotoError)}}" class="photo-feedback" aria-live="polite">
      <text>{{homeUploading?'正在上传商品图…':homePhotoError}}</text><button wx:if="{{homePhotoError && !homeUploading}}" bindtap="uploadHomePhoto">重试上传</button>
    </view>
    <view class="assistant-compose">
      <textarea class="assistant-input" aria-label="推广需求" value="{{homeText}}" maxlength="1200" bindinput="homeInput" disabled="{{homeNavigating}}" placeholder="{{homePhoto?'给这张商品图补一句需求…':'也可以打字，说说店里要推什么…'}}" placeholder-class="assistant-placeholder" cursor-spacing="36"/>
      <view class="compose-tools">
        <button wx:if="{{!homePhoto}}" class="attach-photo" bindtap="pickHomePhoto" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}"><image src="/images/assistant-camera.png" aria-hidden="true"/>拍照 / 选图</button>
        <view wx:else class="attached-label">{{homeAsset?'已添加商品图':'商品图'}}</view>
        <button class="send-brief" bindtap="sendHome" disabled="{{homeNavigating || homeVoiceState !== 'idle' || homeUploading || (homePhoto && !homeAsset) || (!homeHasText && !homeAsset)}}"><text>{{homeAsset && !homeHasText?'用图做海报':'发送'}}</text><text class="send-arrow" aria-hidden="true">↑</text></button>
      </view>
    </view>
    <view wx:if="{{homeError}}" class="assistant-error" aria-live="polite">{{homeError}}</view>
    <button class="call-entry" bindtap="homeCall" disabled="{{homeNavigating || homeVoiceState !== 'idle' || homeUploading || (homePhoto && !homeAsset)}}">
      <view class="call-icon"><image src="/images/assistant-call.png" aria-hidden="true"/></view>
      <view class="call-content"><view class="tool-title">连续语音对话</view><view class="tool-desc">停顿后自动发送，助理会朗读回复</view></view>
      <view class="entry-chevron" aria-hidden="true"></view>
    </button>
    <view class="home-tasks">
      <view class="task-heading">接着做</view>
      <button wx:if="{{homePendingState==='ready' && homePending}}" class="pending-task" bindtap="homeResume" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}">
        <view class="pending-status"><text class="task-dot"></text>{{homePending.label}}<text wx:if="{{homePending.showCost}}" class="task-cost">{{homePending.cost}} 积分</text></view>
        <view class="pending-bottom"><text class="pending-title">{{homePending.title}}</text><text class="pending-action">{{homePending.action}} ›</text></view>
      </button>
      <view wx:elif="{{homePendingState==='error'}}" class="pending-empty"><text>待办暂时无法加载</text><button bindtap="loadHomePending">重试</button></view>
      <view wx:else class="pending-empty" aria-live="polite">{{homePendingState==='loading'?'正在读取待办…':'暂无待处理的任务'}}</view>
    </view>
    <button class="legacy-entry" bindtap="showLegacy" disabled="{{homeNavigating || homeVoiceState !== 'idle'}}"><text>实拍朋友圈与其他创作</text><view class="entry-chevron" aria-hidden="true"></view></button>
  </view>
</view>
<view wx:elif="{{!studio}}" class="page moment-page">
  <button wx:if="{{personalAgent}}" class="link" bindtap="showAssistant">‹ 返回营销助理</button>
  <view class="title">今天的朋友圈</view>
  <view class="panel">
    <button class="moment-photo" aria-label="{{momentAsset?'更换照片':'拍照或从相册选图'}}" bindtap="takeMomentPhoto" disabled="{{busy || momentCost===null}}">
      <image wx:if="{{momentPhoto}}" src="{{momentPhoto}}" mode="aspectFit"/>
      <text wx:if="{{!momentPhoto}}" class="camera-icon" aria-hidden="true"></text>
      <text class="{{momentPhoto?'change-photo':''}}">{{momentAsset?'换张照片':'拍照或从相册选图'}}</text>
    </button>
    <view class="label">补一句话 <text class="sub">（选填）</text></view>
    <textarea class="moment-note" aria-label="补一句话，选填" maxlength="140" value="{{momentNote}}" bindinput="momentInput" disabled="{{busy || momentCost===null}}" placeholder="比如：今天多烤了 10 个可颂，下午 4 点能取。"/>
    <view class="row moment-format"><text class="sub">画幅</text>
      <button class="chip ratio-chip {{momentRatio==='portrait'?'active':''}}" aria-pressed="{{momentRatio==='portrait'}}" data-ratio="portrait" bindtap="momentFormat" disabled="{{busy || momentCost===null}}"><view class="ratio-shape" style="{{shapeStyles[0]}}" aria-hidden="true"/><text>3:4</text></button>
      <button class="chip ratio-chip {{momentRatio==='story'?'active':''}}" aria-pressed="{{momentRatio==='story'}}" data-ratio="story" bindtap="momentFormat" disabled="{{busy || momentCost===null}}"><view class="ratio-shape" style="{{shapeStyles[2]}}" aria-hidden="true"/><text>9:16</text></button>
    </view>
    <view wx:if="{{momentError}}" class="error" aria-live="polite">{{momentError}}</view>
    <button wx:if="{{momentCost===null && momentError}}" class="secondary" bindtap="loadMoment">重新连接</button>
    <button wx:else class="primary" disabled="{{busy || !momentAsset || momentCost===null}}" loading="{{busy}}" bindtap="makeMoment">{{momentJob?'查看这条朋友圈':'做好今天这条朋友圈'}}{{momentCost!==null && !momentJob?' · '+momentCost+' 积分':''}}</button>
  </view>
  <view class="row quick-entries">
    <button class="quick-entry" bindtap="quick" data-mode="image" disabled="{{busy}}">图片文字一键</button>
    <button class="quick-entry" bindtap="quick" data-mode="video" disabled="{{busy}}">视频文字一键</button>
  </view>
  <button class="link" bindtap="toggleStudio" disabled="{{busy}}">其他创作 ›</button>
</view>
<view wx:else class="page">
  <button class="link" bindtap="toggleStudio" disabled="{{busy}}">‹ 今天的朋友圈</button>
  <view class="title">今天要推广什么？</view>
  <view class="panel">
    <view class="row"><button wx:for="{{kinds}}" wx:key="id" data-kind="{{item.id}}" bindtap="changeKind" aria-pressed="{{item.id===kind}}" class="chip {{item.id===kind?'active':''}}">{{item.name}}</button></view>
    <textarea class="prompt" aria-label="创作需求" focus="{{focusBrief}}" bindblur="blurBrief" value="{{brief}}" bindinput="input" maxlength="1200" placeholder="比如，给新品抹茶拿铁做张海报，邀请附近的上班族午休来店。" adjust-position="{{true}}"/>
    <view wx:if="{{briefError}}" class="error" aria-live="polite">{{briefError}}</view>
    <view class="between tools">
      <button wx:if="{{asset}}" class="link" bindtap="showPhoto">{{assetConfirmed?'已选素材':'核对素材'}}</button>
      <button wx:else class="link" bindtap="addPhoto" disabled="{{busy}}" loading="{{uploading}}">{{uploading?'上传中':'＋ 商品素材'}}</button>
      <button wx:if="{{kind!=='copy'}}" class="format" bindtap="settings">{{format.ratio}} · {{format.resolution}} px · {{kind==='video'?'9 秒':format.dpi+' DPI'}}</button>
    </view>
    <button class="primary" bindtap="preview" loading="{{busy && !uploading}}" disabled="{{busy}}">预览创作方案</button>
  </view>
  <view wx:if="{{topics.length || topicsError}}" class="section">
    <view class="heading">本周营销主题</view>
    <button wx:for="{{topics}}" wx:key="topicId" class="topic line between" data-id="{{item.topicId}}" bindtap="useTopic"><text>{{item.title}}</text><text class="sub">{{item.adopted?'已制作':'用这个主题'}} ›</text></button>
    <button wx:if="{{topicsError}}" class="link" bindtap="loadTopics">重新加载本周主题</button>
  </view>
  <view class="between"><view class="heading">找个灵感开始</view><button class="link" bindtap="gallery">查看全部</button></view>
  <button class="hero" bindtap="sample" data-id="tea"><image src="/images/tea-hero.jpg" mode="aspectFill"/><view class="heroTitle">抹茶拿铁<view>上新海报</view></view><view class="heroLink">查看茶饮样张</view></button>
  <button class="mini row" bindtap="sample" data-id="auto"><image src="/images/auto.jpg" mode="aspectFill"/><view><view>周末试驾</view><view class="sub">汽车海报</view></view></button>
</view>
<block wx:if="{{homeVerified && sheet}}">
  <view class="sheetmask" bindtap="close"></view>
  <view class="sheet">
    <view class="between"><view class="heading">{{sheet==='asset'?'核对商品图':'输出规格'}}</view><button class="close" bindtap="close">关闭</button></view>
    <block wx:if="{{sheet==='format'}}">
      <view class="line"><text>画幅</text><view class="ratio-row"><button wx:for="{{ratios}}" wx:key="*this" class="chip ratio-chip {{format.ratio===item?'active':''}}" aria-pressed="{{format.ratio===item}}" data-index="{{index}}" bindtap="pickRatio"><view class="ratio-shape" style="{{shapeStyles[index]}}" aria-hidden="true"/><text>{{item}}</text></button></view></view>
      <picker range="{{resolutions}}" value="{{resolutionIndex}}" data-key="resolution" bindchange="selectFormat"><view class="line between"><text>短边分辨率</text><text>{{format.resolution}} px　›</text></view></picker>
      <picker wx:if="{{kind==='poster'}}" range="{{dpis}}" value="{{dpiIndex}}" data-key="dpi" bindchange="selectFormat"><view class="line between"><text>印刷精度</text><text>{{format.dpi}} DPI　›</text></view></picker>
      <button class="primary spaced" bindtap="close">完成</button>
    </block>
    <block wx:else>
      <image wx:if="{{assetImage}}" class="photo" src="{{assetImage}}" mode="aspectFit"/>
      <view wx:elif="{{photoError}}" class="photo-status"><text>{{photoError}}</text><button class="link" bindtap="showPhoto">重新加载商品图</button></view>
      <view wx:else class="photo-status">正在加载商品图…</view>
      <view class="line between">使用上传原图<switch checked="{{assetMode==='original'}}" bindchange="togglePhoto" color="#184b32"/></view>
      <button wx:if="{{!asset.risk}}" class="link" bindtap="startMark">{{identityRegion?'重新标注原图区域':'标注需保真的标识或包装文字'}}</button>
      <button wx:if="{{kind==='video' && !asset.risk}}" class="link" bindtap="startMark" data-target="detail">{{visualDetail?'重新框选中镜细节':'指定短片中镜的细节（选填）'}}</button>
      <block wx:if="{{marking}}">
        <view class="note">{{firstCorner?'再点选区对角':markingDetail?'在原图上框住第 3–6 秒要展示的细节。':'在原图上点选标识的一角，再点对角。'}}</view>
        <view class="region-wrap"><image class="region-image" src="{{regionImage}}" mode="widthFix" bindtap="markPoint"/><view wx:if="{{regionStyle}}" class="region-outline" style="{{regionStyle}}"/></view>
      </block>
      <button wx:if="{{identityRegion}}" class="link" bindtap="clearRegion">清除标识选区</button>
      <block wx:if="{{kind==='video' && visualDetail}}">
        <input class="line" maxlength="20" placeholder="框内可见的卖点，如杯壁刻度" value="{{visualDetail.label}}" bindinput="detailLabel"/>
        <button class="link" bindtap="clearRegion" data-target="detail">清除中镜细节</button>
      </block>
      <view wx:if="{{asset.risk}}" class="error">图片质量不足，建议移除后更换清晰原图。</view>
      <button class="primary spaced" disabled="{{!assetImage || firstCorner || asset.risk}}" bindtap="acceptPhoto">确认素材</button>
      <button class="secondary spaced" bindtap="removePhoto">移除素材</button>
    </block>
  </view>
</block>
