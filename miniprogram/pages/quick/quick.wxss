/* Shared page classes come from app.wxss and home.wxss is page-scoped. */
.prompt {
  width: 100%;
  height: 190rpx;
  padding: 24rpx 0 12rpx;
  font-size: 31rpx;
  line-height: 1.6;
}
.tools {
  margin: 8rpx 0 14rpx;
  flex-wrap: wrap;
}
.ratio-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.ratio-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}
.ratio-shape {
  display: inline-block;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}
.moment-note {
  box-sizing: border-box;
  width: 100%;
  height: 138rpx;
  padding: 10rpx 0;
  font-size: 28rpx;
}
