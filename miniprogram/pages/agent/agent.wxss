.turn {
  padding: 22rpx 24rpx;
  margin: 16rpx 0;
  background: white;
  border: 1rpx solid #dce5d9;
  border-radius: 18rpx;
  white-space: pre-line;
}
.turn.user {
  background: #e7efde;
  margin-left: 42rpx;
}
.turn button {
  margin: 10rpx 0;
}
.panel textarea {
  width: 100%;
  min-height: 120rpx;
}
.heading {
  flex: 1;
}
.chat-page { padding: 28rpx 30rpx 90rpx; }
.conversation-title { line-height: 1.3; font-size: 36rpx; overflow-wrap: anywhere; }
.chat-page .between .link { font-size: 26rpx; min-height: 44px; }
.chat-page .turn { padding: 24rpx; border-color: #d8e0d5; }
.task-card .card-state, .card-state { font-size: 25rpx; font-weight: 650; color: #375941; }
.request-line { margin: 8rpx 0 10rpx; font-size: 33rpx; line-height: 1.42; font-weight: 660; }
.locked-copy { margin: 16rpx 0; padding: 18rpx 22rpx; background: #f0f4e9; border-radius: 14rpx; }
.focused-card { border-color: #54805d; }
.reply-tools { display: flex; justify-content: flex-end; }
.composer { background: #fff; border: 1px solid #cbd8c9; border-radius: 26rpx; padding: 21rpx 24rpx 12rpx; margin: 16rpx 0 10rpx; }
.chat-input { box-sizing: border-box; min-height: 98rpx; height: 120rpx; width: 100%; font-size: 30rpx; line-height: 1.55; }
.compose-tools,.attachment { display: flex; align-items: center; gap: 18rpx; }
.attachment { padding-bottom: 16rpx; font-size: 26rpx; }
.attachment image { width: 84rpx; height: 84rpx; border-radius: 10rpx; }
.attachment text { flex: 1; }
.small-action,.send-action,.call-switch,.end-call { display: flex; align-items: center; justify-content: center; min-height: 44px; font-size: 27rpx; font-weight: 620; }
.small-action { padding: 0 6rpx; color: #2f593e; }
.send-action { margin-left: auto; background: #184b32; color: #fff; border-radius: 18rpx; padding: 0 28rpx; }
.send-action[disabled] { background: #e4eae0; color: #626f65; }
.call-entry { margin: 20rpx 0; text-align: center; }
.call-switch { width: 100%; background: #e5efd9; color: #184b32; border-radius: 18rpx; }
.call-hint,.status-note { margin-top: 12rpx; font-size: 25rpx; }
.live-call { position: fixed; left: 20rpx; right: 20rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 20rpx; padding: 18rpx 24rpx; background: #163d2c; border-radius: 24rpx; color: #fff; z-index: 5; }
.live-caption { flex: 1; font-size: 26rpx; }
.live-caption .card-state { color: #d7f694; }
.end-call { background: #fff; color: #263a2e; border-radius: 15rpx; padding: 0 16rpx; }
.chat-page.on-call { padding-bottom: 190rpx; }
.conversation-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.turn .line, .chat-page .panel button.line { display: block; width: 100%; min-height: 44px; text-align: left; }
