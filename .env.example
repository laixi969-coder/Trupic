# 服务进程从环境读取这些变量。可选配置只在启用对应服务时设置。
PORT=7341
TRUPIC_HOST=127.0.0.1
TRUPIC_DATA=.trupic
TRUPIC_VIDEO_RENDERER=ffmpeg
# TRUPIC_ADMIN_KEY=
# TRUPIC_CJK_FONT=

# 配置已验签的收款桥，正式商户凭据留在桥接服务。
# TRUPIC_CHECKOUT_URL=
# TRUPIC_PAYMENT_SECRET=
# 未付款订单超过这么多分钟后关闭，并退回它占用的优惠券。默认 120。
# TRUPIC_ORDER_TTL_MINUTES=

# 同一来源对同一账号连续登录失败达到次数后暂停十分钟，0 表示不限制。默认 20。
# TRUPIC_SIGNIN_FAILURES=

# 未注册的访客每个工作空间领一份体验积分。同一网络每 24 小时最多发放这么多份，0 表示不限制。默认 5。
# TRUPIC_TRIAL_PER_DAY=
# 服务前面有会改写 X-Forwarded-For 的反向代理（如 Nginx）时设为 1，才按真实访客地址计数。
# TRUPIC_TRUST_PROXY=1

# 腾讯云 COS 私有桶与服务端凭据。临时密钥同时需要令牌。
# TRUPIC_COS_BUCKET=
# TRUPIC_COS_REGION=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_SECURITY_TOKEN=

# 设置后，后台保存的供应商密钥与 integrations.json 中的密钥在磁盘上加密保存（首次设置前已保存的密钥保持明文，重新保存一次即加密）。
# 一旦设置请妥善备份：换掉或丢失后，已加密的密钥无法再读取。开发与测试可不设置。
# TRUPIC_SECRET_KEY=
# 正式路由需先核验系列版本和实际测试记录；须有 2026 年起实际发布日期及官方依据。主备连接可在运营后台保存。
# TRUPIC_MODEL_STAGE=production
# 同一平台同一能力最近这么多次调用全部失败时暂停使用它，只走备用连接；0 表示不启用熔断。默认 3。
# TRUPIC_BREAKER_FAILURES=
# 熔断持续这么多秒，之后会重新尝试主连接。默认 120。
# TRUPIC_BREAKER_SECONDS=
# TRUPIC_DAILY_TEXT_CALLS=
# TRUPIC_DAILY_VISION_CALLS=
# TRUPIC_DAILY_IMAGE_CALLS=
# TRUPIC_DAILY_EDIT_CALLS=
# TRUPIC_DAILY_VIDEO_CALLS=
# 启用金额预算时，为每项使用的能力设置单次预留金额。
# TRUPIC_DAILY_BUDGET_CNY=
# TRUPIC_TEXT_RESERVE_CNY=
# TRUPIC_VISION_RESERVE_CNY=
# TRUPIC_IMAGE_RESERVE_CNY=
# TRUPIC_EDIT_RESERVE_CNY=
# TRUPIC_VIDEO_RESERVE_CNY=

# 仅配置已取得使用许可的参考来源。
# TRUPIC_REFERENCE_FEED=
# TRUPIC_FEED_LICENSE=
# TRUPIC_PINTEREST_BOARD=
# TRUPIC_PINTEREST_TOKEN=
# TRUPIC_PINTEREST_LICENSE=

# 手机网页营销助理。内部环境默认启用，正式路由环境默认灰度 0%。
# TRUPIC_PERSONAL_AGENT=1
# TRUPIC_AGENT_ROLLOUT=100
# 全局制作线程数，以及每商家同时执行的助理任务数（0 使用原有队列）。
# TRUPIC_JOB_WORKERS=2
# TRUPIC_AGENT_ACTIVE_LIMIT=0

# 营销助理语音均在本机处理。可指定已安装的 whisper.cpp CLI、多语 GGML 模型与系统中文嗓音。
# TRUPIC_WHISPER_CLI=/path/to/whisper-cli
# TRUPIC_WHISPER_MODEL=/path/to/ggml-small.bin
# TRUPIC_TTS_VOICE=Tingting
